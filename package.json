{
  "name": "dsh-neoforge",
  "version": "0.2.0",
  "description": "NeoForge-style standard API layer for DeepSeek Harness plugins: runtime mixins with snapshot/restore + a Cordis-native event bus",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "default": "./dist/relay.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "@official/chat-runtime": "file:test/fixtures/node_modules/@official/chat-runtime",
    "@official/chat": "file:test/fixtures/node_modules/@official/chat"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js"
}
