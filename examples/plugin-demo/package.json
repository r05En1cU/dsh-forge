{
  "name": "dsh-plugin-demo",
  "version": "0.2.0",
  "description": "Pure forge-semantics better-sidebar demo: one plugin, webui (better-sidebar tab) + tui (fabric-injected sidebar), same forge events for files and git diff",
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./fabric-bootstrap": "./fabric-bootstrap.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "src/client.js",
    "fabric-bootstrap.mjs",
    "cordis.patch.yml",
    "scripts/build-client.mjs",
    "README.md"
  ],
  "scripts": {
    "build:client": "node scripts/build-client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
